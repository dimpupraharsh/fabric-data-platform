<mxfile host="app.diagrams.net" modified="2026-09-29T18:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="high-level" name="01 - High-Level Architecture">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title1" value="Retail Order Intelligence | High-Level Architecture" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1000" height="42" as="geometry"/></mxCell>
        <mxCell id="subtitle1" value="Current deployment and planned serving layer | Fabric medallion architecture" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#526477;" vertex="1" parent="1"><mxGeometry x="42" y="70" width="1000" height="25" as="geometry"/></mxCell>
        <mxCell id="sourceHdr" value="SOURCE SYSTEMS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F6FA;strokeColor=#AAB8C5;fontStyle=1;fontSize=14;fontColor=#17324D;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="260" height="42" as="geometry"/></mxCell>
        <mxCell id="bronzeHdr" value="BRONZE | LAKEHOUSE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D9;strokeColor=#E2A33A;fontStyle=1;fontSize=14;fontColor=#714500;align=center;" vertex="1" parent="1"><mxGeometry x="360" y="130" width="270" height="42" as="geometry"/></mxCell>
        <mxCell id="silverHdr" value="SILVER | LAKEHOUSE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F2F7;strokeColor=#5A9AB8;fontStyle=1;fontSize=14;fontColor=#164A63;align=center;" vertex="1" parent="1"><mxGeometry x="700" y="130" width="300" height="42" as="geometry"/></mxCell>
        <mxCell id="goldHdr" value="GOLD | WAREHOUSE (PLANNED)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7CC;strokeColor=#D2B33E;fontStyle=1;fontSize=14;fontColor=#695400;align=center;" vertex="1" parent="1"><mxGeometry x="1070" y="130" width="290" height="42" as="geometry"/></mxCell>
        <mxCell id="consumeHdr" value="CONSUMPTION (PLANNED)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4EC;strokeColor=#68A77B;fontStyle=1;fontSize=14;fontColor=#205333;align=center;" vertex="1" parent="1"><mxGeometry x="1430" y="130" width="230" height="42" as="geometry"/></mxCell>
        <mxCell id="pgSource" value="&lt;b&gt;PostgreSQL | salefisher.retail_oi&lt;/b&gt;&lt;br&gt;Customer and product masters&lt;br&gt;Sales order lines (15M+)&lt;br&gt;Order, shipment, payment events&lt;br&gt;&lt;br&gt;&lt;font color='#526477'&gt;Mac host via Windows on-premises gateway&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#527A9E;strokeWidth=2;fontSize=13;fontColor=#243746;align=left;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="205" width="260" height="190" as="geometry"/></mxCell>
        <mxCell id="s3Source" value="&lt;b&gt;Amazon S3 | fabric-datawarehouse-project&lt;/b&gt;&lt;br&gt;Geography, delivery zones,&lt;br&gt;warehouse coverage, geo hierarchy&lt;br&gt;&lt;br&gt;&lt;font color='#526477'&gt;Reference/enrichment only&lt;br&gt;Refresh as full snapshots when files change&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#527A9E;strokeWidth=2;fontSize=13;fontColor=#243746;align=left;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="260" height="180" as="geometry"/></mxCell>
        <mxCell id="sourceNote" value="Optional source simulator is for controlled project testing; it is not a Fabric production dependency." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5DF;dashed=1;fontSize=11;fontColor=#526477;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="controlPlane" value="&lt;b&gt;wh_retail_control | CONTROL PLANE&lt;/b&gt;&lt;br&gt;Metadata-driven orchestration and governance&lt;br&gt;Source config • connections • object/load state • locks/checkpoints&lt;br&gt;Pipeline/object runs • schema contracts/drift • batch manifests • quality results&lt;br&gt;&lt;font color='#526477'&gt;No credentials stored in control tables&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#7773B5;strokeWidth=2;fontSize=13;fontColor=#28265C;align=center;spacing=10;" vertex="1" parent="1"><mxGeometry x="360" y="205" width="1300" height="125" as="geometry"/></mxCell>
        <mxCell id="bronzeBox" value="&lt;b&gt;lh_retail_bronze&lt;/b&gt;&lt;br&gt;Source-shaped arrivals + lineage&lt;br&gt;&lt;br&gt;PostgreSQL masters: append snapshots&lt;br&gt;Sales/events: watermark deltas&lt;br&gt;S3 reference files: append snapshots on change&lt;br&gt;&lt;br&gt;Preserve source values; no business cleansing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9EF;strokeColor=#E2A33A;strokeWidth=2;fontSize=13;fontColor=#46351D;align=left;spacing=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="360" y="390" width="270" height="260" as="geometry"/></mxCell>
        <mxCell id="silverBox" value="&lt;b&gt;lh_retail_silver&lt;/b&gt;&lt;br&gt;Conformed and quality-checked data&lt;br&gt;&lt;br&gt;Standardize and deduplicate&lt;br&gt;Resolve late-arriving facts / dimensions&lt;br&gt;Customer, product, category, location dimensions&lt;br&gt;Sales and lifecycle event facts&lt;br&gt;SCD Type 2 history where defined&lt;br&gt;DQ rejects + reconciliation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F9FC;strokeColor=#5A9AB8;strokeWidth=2;fontSize=13;fontColor=#193B4A;align=left;spacing=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="390" width="300" height="300" as="geometry"/></mxCell>
        <mxCell id="goldBox" value="&lt;b&gt;wh_retail_gold&lt;/b&gt;&lt;br&gt;Planned business serving layer&lt;br&gt;&lt;br&gt;Conformed star schema&lt;br&gt;Sales and fulfillment facts&lt;br&gt;Daily/monthly and customer/product marts&lt;br&gt;Shipping SLA and lifecycle reporting&lt;br&gt;&lt;br&gt;&lt;font color='#8A6D00'&gt;Not yet implemented&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFCDF;strokeColor=#D2B33E;strokeWidth=2;dashed=1;fontSize=13;fontColor=#463D1C;align=left;spacing=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1070" y="390" width="290" height="260" as="geometry"/></mxCell>
        <mxCell id="consumeBox" value="&lt;b&gt;Future consumers&lt;/b&gt;&lt;br&gt;&lt;br&gt;Power BI semantic model&lt;br&gt;Business dashboards&lt;br&gt;Governed SQL analysis&lt;br&gt;&lt;br&gt;&lt;font color='#526477'&gt;Built on Gold only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2FAF4;strokeColor=#68A77B;strokeWidth=2;dashed=1;fontSize=13;fontColor=#254332;align=left;spacing=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1430" y="390" width="230" height="220" as="geometry"/></mxCell>
        <mxCell id="flowPg" value="Daily: snapshot + watermark" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3478A5;strokeWidth=2;fontSize=11;fontColor=#31566F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pgSource" target="bronzeBox"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="flowS3" value="On change: full snapshot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3478A5;strokeWidth=2;fontSize=11;fontColor=#31566F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s3Source" target="bronzeBox"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="flowBS" value="Batch-driven transforms" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3478A5;strokeWidth=2;fontSize=11;fontColor=#31566F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bronzeBox" target="silverBox"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="flowSG" value="Later phase" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#8F8A55;strokeWidth=2;dashed=1;fontSize=11;fontColor=#756B2D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="silverBox" target="goldBox"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="flowGC" value="Later phase" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#8F8A55;strokeWidth=2;dashed=1;fontSize=11;fontColor=#756B2D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="goldBox" target="consumeBox"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="controlEdge" value="Config, state, audit, schema &amp; quality" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#7773B5;strokeWidth=2;dashed=1;fontSize=11;fontColor=#49458A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="controlPlane" target="bronzeBox"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="silverCtlEdge" value="Run orchestration / checkpoints" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#7773B5;strokeWidth=2;dashed=1;fontSize=11;fontColor=#49458A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="controlPlane" target="silverBox"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="legend1" value="&lt;b&gt;Status key&lt;/b&gt;   Solid boxes/arrows = deployed and validated   |   Dashed boxes/arrows = planned or optional path" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#526477;" vertex="1" parent="1"><mxGeometry x="360" y="760" width="1100" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="daily-processing" name="02 - Daily Processing and Controls">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title2" value="Daily Processing | Orchestration, Checkpoints and Replay Safety" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=25;fontStyle=1;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1250" height="42" as="geometry"/></mxCell>
        <mxCell id="sub2" value="Routine schedule: 06:00 Europe/London | PostgreSQL runs daily; S3 runs only when reference files change" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#526477;" vertex="1" parent="1"><mxGeometry x="42" y="70" width="1200" height="25" as="geometry"/></mxCell>
        <mxCell id="start" value="&lt;b&gt;PostgreSQL source&lt;/b&gt;&lt;br&gt;retail_oi tables&lt;br&gt;Changes arrive independently" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#527A9E;strokeWidth=2;fontSize=13;fontColor=#243746;align=center;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="205" height="105" as="geometry"/></mxCell>
        <mxCell id="dailyParent" value="&lt;b&gt;pl_daily_retail_processing&lt;/b&gt;&lt;br&gt;Scheduled entry point&lt;br&gt;Serial dispatch; failure blocks downstream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#7773B5;strokeWidth=2;fontSize=13;fontColor=#28265C;align=center;spacing=10;" vertex="1" parent="1"><mxGeometry x="290" y="180" width="245" height="125" as="geometry"/></mxCell>
        <mxCell id="bronzeParent" value="&lt;b&gt;pl_bronze_orchestrator&lt;/b&gt;&lt;br&gt;Reads active source metadata&lt;br&gt;Routes to reusable child pipelines" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D9;strokeColor=#E2A33A;strokeWidth=2;fontSize=13;fontColor=#714500;align=center;spacing=10;" vertex="1" parent="1"><mxGeometry x="580" y="180" width="245" height="125" as="geometry"/></mxCell>
        <mxCell id="switch" value="&lt;b&gt;Dispatch by load strategy&lt;/b&gt;&lt;br&gt;snapshot_append or watermark_incremental" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A7B42;strokeWidth=2;fontSize=12;fontColor=#4E4527;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="880" y="180" width="230" height="125" as="geometry"/></mxCell>
        <mxCell id="target" value="&lt;b&gt;lh_retail_bronze&lt;/b&gt;&lt;br&gt;Raw tables + ingest lineage&lt;br&gt;Committed batch manifest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9EF;strokeColor=#E2A33A;strokeWidth=2;fontSize=13;fontColor=#46351D;align=center;spacing=10;" vertex="1" parent="1"><mxGeometry x="1170" y="190" width="220" height="105" as="geometry"/></mxCell>
        <mxCell id="silverRun" value="&lt;b&gt;pl_silver_orchestrator&lt;/b&gt;&lt;br&gt;load_mode=incremental&lt;br&gt;Processes committed Bronze arrivals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F2F7;strokeColor=#5A9AB8;strokeWidth=2;fontSize=13;fontColor=#164A63;align=center;spacing=10;" vertex="1" parent="1"><mxGeometry x="1440" y="190" width="190" height="105" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#3478A5;strokeWidth=2;" edge="1" parent="1" source="start" target="dailyParent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#3478A5;strokeWidth=2;" edge="1" parent="1" source="dailyParent" target="bronzeParent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#3478A5;strokeWidth=2;" edge="1" parent="1" source="bronzeParent" target="switch"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#3478A5;strokeWidth=2;" edge="1" parent="1" source="switch" target="target"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#3478A5;strokeWidth=2;" edge="1" parent="1" source="target" target="silverRun"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="inventoryTitle" value="Configured PostgreSQL source objects" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=17;fontStyle=1;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="600" height="30" as="geometry"/></mxCell>
        <mxCell id="snapshot" value="&lt;b&gt;Snapshot append&lt;/b&gt;&lt;br&gt;1001 customer_master&lt;br&gt;1002 product_master&lt;br&gt;Small reference/master snapshots&lt;br&gt;Silver compares versions before SCD2 changes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F5FF;strokeColor=#8881B8;strokeWidth=2;fontSize=13;fontColor=#302D56;align=left;spacing=13;" vertex="1" parent="1"><mxGeometry x="40" y="425" width="320" height="180" as="geometry"/></mxCell>
        <mxCell id="watermark" value="&lt;b&gt;Watermark incremental&lt;/b&gt;&lt;br&gt;1003 sales_order_line&lt;br&gt;1004 order_status_event&lt;br&gt;1005 shipment_status_event&lt;br&gt;1006 payment_status_event&lt;br&gt;Bounded by dwh_load_ts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F7FB;strokeColor=#5A9AB8;strokeWidth=2;fontSize=13;fontColor=#193B4A;align=left;spacing=13;" vertex="1" parent="1"><mxGeometry x="390" y="425" width="350" height="180" as="geometry"/></mxCell>
        <mxCell id="s3path" value="&lt;b&gt;Separate S3 reference refresh&lt;/b&gt;&lt;br&gt;Manual/on-change invocation only&lt;br&gt;Four CSVs copied as full snapshots&lt;br&gt;Object IDs 2001-2004&lt;br&gt;No row watermark and not on daily schedule" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3FAF4;strokeColor=#68A77B;strokeWidth=2;dashed=1;fontSize=13;fontColor=#254332;align=left;spacing=13;" vertex="1" parent="1"><mxGeometry x="770" y="425" width="330" height="180" as="geometry"/></mxCell>
        <mxCell id="s3ToBronze" value="Full snapshot on file change" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#68A77B;strokeWidth=2;dashed=1;fontSize=11;fontColor=#356448;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s3path" target="target"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="guardTitle" value="Control-plane gates and operational checks" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=17;fontStyle=1;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="1140" y="370" width="500" height="30" as="geometry"/></mxCell>
        <mxCell id="guards" value="&lt;b&gt;Before copy&lt;/b&gt;&lt;br&gt;Acquire per-object lock; read committed lower watermark; capture fixed source upper bound.&lt;br&gt;&lt;br&gt;&lt;b&gt;Commit only after success&lt;/b&gt;&lt;br&gt;Validate copy metrics and target; write manifest/batch evidence; then advance checkpoint and release lock.&lt;br&gt;&lt;br&gt;&lt;b&gt;On retry&lt;/b&gt;&lt;br&gt;Reuse deterministic batch identity; remove only partial rows for that batch; keep prior checkpoint on failure." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F5FC;strokeColor=#7773B5;strokeWidth=2;fontSize=13;fontColor=#302D56;align=left;spacing=14;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1140" y="425" width="490" height="245" as="geometry"/></mxCell>
        <mxCell id="controlBand" value="&lt;b&gt;wh_retail_control&lt;/b&gt; is the Fabric checkpoint authority: source/object configuration, connection references, load state and locks, pipeline/object run logs, schema contracts/observations/drift events, Bronze batch manifests, and quality results. PostgreSQL source columns are read for extraction; Fabric control state advances only after a successful Bronze commit." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#7773B5;strokeWidth=2;fontSize=13;fontColor=#28265C;align=left;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1590" height="110" as="geometry"/></mxCell>
        <mxCell id="note2" value="Source simulation is an optional test aid, not a production orchestration prerequisite. Silver baseline is reserved for an intentional rebuild; routine daily processing uses incremental mode." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#526477;" vertex="1" parent="1"><mxGeometry x="40" y="835" width="1450" height="35" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
