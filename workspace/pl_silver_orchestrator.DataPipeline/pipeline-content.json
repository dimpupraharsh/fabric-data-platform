                "value": "@concat('EXEC control.sp_finish_silver_run @pipeline_run_id = ''', pipeline().RunId, ''', @run_status = ''succeeded'';')",
                "type": "Expression"
              }
            }
          ],
          "scriptBlockExecutionTimeout": "00:02:00"
        },
        "externalReferences": {
          "connection": "ffb74af9-9d17-4429-8493-02465e631244"
        },
        "description": "Marks the Silver run successful and advances transform state only after all builds and reconciliation pass."
      },
