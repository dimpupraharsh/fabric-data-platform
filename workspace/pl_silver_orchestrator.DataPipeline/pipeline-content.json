{
  "properties": {
    "description": "Runs Silver in order: lock, set arrival boundary, build SCD dimensions/coverage, merge events and sales, reconcile, then commit. Failures are logged and release locks; baseline rebuilds, incremental processes new arrivals.",
    "parameters": {
      "load_mode": {
        "type": "String",
        "defaultValue": "incremental"
      }
    },
    "activities": [
      {
        "name": "StartSilverRunAndAcquireLocks",
        "type": "Script",
        "dependsOn": [],
        "policy": {
          "timeout": "0.00:05:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "scripts": [
            {
              "type": "Query",
              "text": {
                "value": "@concat('EXEC control.sp_start_silver_run @pipeline_run_id = ''', pipeline().RunId, ''', @load_mode = ''', pipeline().parameters.load_mode, ''';')",
                "type": "Expression"
              }
            }
          ],
          "scriptBlockExecutionTimeout": "00:02:00"
        },
        "externalReferences": {
          "connection": "ffb74af9-9d17-4429-8493-02465e631244"
        },
        "description": "Creates the Silver run record and acquires transform locks so overlapping executions cannot write the same targets."
      },
      {
        "name": "ResolveSilverIngestLowerBound",
        "type": "Script",
        "dependsOn": [
          {
            "activity": "StartSilverRunAndAcquireLocks",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.00:05:00",
          "retry": 1,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "scripts": [
            {
              "type": "Query",
              "text": {
                "value": "SELECT COALESCE(CONVERT(VARCHAR(33), MIN(last_success_ts), 126), '1900-01-01T00:00:00.000') AS lower_bound_ts FROM control.ctl_transform_state WHERE baseline_completed = CAST(1 AS BIT);",
                "type": "Expression"
              }
            }
          ],
          "scriptBlockExecutionTimeout": "00:02:00"
        },
        "externalReferences": {
          "connection": "ffb74af9-9d17-4429-8493-02465e631244"
        },
        "description": "Reads the last committed Silver arrival boundary used by event and sales notebooks to select newly landed Bronze versions."
      },
      {
        "name": "BuildSilverDimensionsAndBridges",
        "type": "TridentNotebook",
        "dependsOn": [
          {
            "activity": "ResolveSilverIngestLowerBound",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.06:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "baff3993-17eb-4514-9ae3-fc3a6d586083",
          "workspaceId": "fba1bab2-0098-4b65-9f4f-cb304d71b700",
          "parameters": {
            "pipeline_run_id": {
              "value": "@pipeline().RunId",
              "type": "string"
            },
            "load_mode": {
              "value": "@pipeline().parameters.load_mode",
              "type": "string"
            }
          }
        },
        "description": "Runs the dimensions notebook to conform customer, product, category, location, and warehouse coverage history before facts resolve keys."
      },
      {
        "name": "BuildSilverEventFacts",
        "type": "TridentNotebook",
        "dependsOn": [
          {
            "activity": "BuildSilverDimensionsAndBridges",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.06:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "45fa2f38-3b1b-4402-99dd-e7e9d32a4310",
          "workspaceId": "fba1bab2-0098-4b65-9f4f-cb304d71b700",
          "parameters": {
            "pipeline_run_id": {
              "value": "@pipeline().RunId",
              "type": "string"
            },
            "load_mode": {
              "value": "@pipeline().parameters.load_mode",
              "type": "string"
            },
            "lower_bound_ts": {
              "value": "@activity('ResolveSilverIngestLowerBound').output.resultSets[0].rows[0].lower_bound_ts",
              "type": "string"
            }
          }
        },
        "description": "Runs the event notebook to standardize and idempotently merge order, shipment, and payment events by source event key."
      },
      {
        "name": "BuildSilverSalesFact",
        "type": "TridentNotebook",
        "dependsOn": [
