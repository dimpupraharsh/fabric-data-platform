/// One row per order, anchored to the source order header and reconciled to its sales lines.
table fact_order
	lineageTag: 1ca99756-79d3-432b-824f-d9a28eb2719d
	sourceLineageTag: [gold].[fact_order]

	/// Orders passing the Gold order-identity and date eligibility rules.
	measure 'Eligible Orders' = CALCULATE(COUNTROWS('fact_order'), 'fact_order'[is_order_metric_eligible] = TRUE())
		formatString: #,0

	/// Sum of booked line revenue assigned to eligible orders.
	measure 'Eligible Order Gross Booked Sales' = CALCULATE(SUM('fact_order'[gross_booked_sales_amount]), 'fact_order'[is_order_metric_eligible] = TRUE())
		formatString: #,0.00

	/// Eligible booked revenue divided by eligible distinct orders.
	measure 'Average Order Value' = DIVIDE([Eligible Order Gross Booked Sales], [Eligible Orders])
		formatString: #,0.00

	/// Eligible orders whose latest status is cancelled.
	measure 'Cancelled Orders' = CALCULATE([Eligible Orders], 'fact_order'[order_status] = "cancelled")
		formatString: #,0

	/// Current cancelled-order share among eligible orders; not a cohort conversion rate.
	measure 'Cancellation Rate' = DIVIDE([Cancelled Orders], [Eligible Orders])
		formatString: 0.0%;-0.0%;0.0%

	/// Eligible orders whose latest status is returned.
	measure 'Returned Orders' = CALCULATE([Eligible Orders], 'fact_order'[order_status] = "returned")
		formatString: #,0

	/// Current returned-order share among eligible orders.
	measure 'Return Rate' = DIVIDE([Returned Orders], [Eligible Orders])
		formatString: 0.0%;-0.0%;0.0%

	/// Eligible orders with a valid due date and delivery timestamp for SLA evaluation.
	measure 'SLA Eligible Deliveries' = CALCULATE([Eligible Orders], 'fact_order'[is_shipping_sla_eligible] = TRUE())
		formatString: #,0

	/// SLA-eligible orders delivered on or before their due date.
	measure 'On-Time Deliveries' = CALCULATE([SLA Eligible Deliveries], FILTER('fact_order', INT('fact_order'[delivered_ts]) <= 'fact_order'[due_date]))
		formatString: #,0

	/// On-time deliveries divided by SLA-eligible deliveries.
	measure 'On-Time Delivery Rate' = DIVIDE([On-Time Deliveries], [SLA Eligible Deliveries])
		formatString: 0.0%;-0.0%;0.0%

	/// Eligible orders whose latest payment status is paid.
	measure 'Paid Orders' = CALCULATE([Eligible Orders], 'fact_order'[payment_status] = "paid")
		formatString: #,0

	/// Latest paid-status share of eligible orders; not a payment-attempt conversion rate.
	measure 'Paid Order Share' = DIVIDE([Paid Orders], [Eligible Orders])
		formatString: 0.0%;-0.0%;0.0%

