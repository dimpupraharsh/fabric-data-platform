/// One row per source sales line. Eligibility excludes invalid line arithmetic and dates.
table fact_sales
	lineageTag: 4d308858-9530-499c-8708-2be45e09e78f
	sourceLineageTag: [gold].[fact_sales]

	/// Booked line revenue, excluding lines that fail the Gold KPI eligibility rules.
	measure 'Gross Booked Sales' = CALCULATE(SUM('fact_sales'[sales_amount]), 'fact_sales'[is_sales_eligible] = TRUE())
		formatString: #,0.00

	/// Quantity sold on eligible sales lines.
	measure 'Units Sold' = CALCULATE(SUM('fact_sales'[quantity]), 'fact_sales'[is_sales_eligible] = TRUE())
		formatString: #,0

	/// Count of eligible sales lines, not orders.
	measure 'Sales Lines' = CALCULATE(COUNTROWS('fact_sales'), 'fact_sales'[is_sales_eligible] = TRUE())
		formatString: #,0

	/// Revenue per unit on eligible sales lines.
	measure 'Average Selling Price' = DIVIDE([Gross Booked Sales], [Units Sold])
		formatString: #,0.00

	/// Booked revenue for equivalent prior-year dates; blank without a date selection.
	measure 'Prior Year Gross Booked Sales' = IF(ISFILTERED('dim_date'), CALCULATE([Gross Booked Sales], SAMEPERIODLASTYEAR('dim_date'[calendar_date])))
		formatString: #,0.00

	/// Exploratory date-aligned YoY; use completed years for the certified annual KPI.
	measure 'Gross Booked Sales YoY %' = IF(ISFILTERED('dim_date'), DIVIDE([Gross Booked Sales] - [Prior Year Gross Booked Sales], [Prior Year Gross Booked Sales]))
		formatString: 0.0%;-0.0%;0.0%

