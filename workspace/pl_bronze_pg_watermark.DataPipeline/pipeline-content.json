{
  "properties": {
    "description": "Incremental PostgreSQL child: lock the object, freeze inclusive dwh_load_ts/key bounds, prepare a batch, copy its delta with lineage, validate and write a manifest, then commit. Failures do not advance the watermark; retries replay the interval.",
    "parameters": {
      "source_object_id": {
        "type": "String"
      },
      "source_schema": {
        "type": "String",
        "defaultValue": "retail_oi"
      },
      "source_table": {
        "type": "String"
      },
      "bronze_target": {
        "type": "String"
      },
      "watermark_column": {
        "type": "String",
        "defaultValue": "dwh_load_ts"
      },
      "tie_breaker_column": {
        "type": "String"
      }
    },
    "activities": [
      {
        "name": "CaptureUpperBoundAndSchema",
        "type": "Lookup",
        "dependsOn": [],
        "policy": {
          "timeout": "0.02:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "PostgreSqlSource",
            "partitionOption": "None",
            "queryTimeout": "02:00:00",
            "query": {
              "value": "@concat('SELECT COALESCE(to_char(u.upper_watermark AT TIME ZONE ''UTC'', ''YYYY-MM-DD\"T\"HH24:MI:SS.MS''), ''1900-01-01T00:00:00.000'') AS upper_watermark, COALESCE(u.upper_tie_breaker, ''0'') AS upper_tie_breaker, c.columns_csv, c.schema_json FROM (SELECT string_agg(lower(column_name), '','' ORDER BY ordinal_position) AS columns_csv, json_agg(json_build_object(''name'', lower(column_name), ''type'', lower(data_type), ''ordinal_position'', ordinal_position) ORDER BY ordinal_position)::text AS schema_json FROM information_schema.columns WHERE table_schema = ''', pipeline().parameters.source_schema, ''' AND table_name = ''', pipeline().parameters.source_table, ''') c LEFT JOIN LATERAL (SELECT \"', pipeline().parameters.watermark_column, '\" AS upper_watermark, \"', pipeline().parameters.tie_breaker_column, '\"::text AS upper_tie_breaker FROM \"', pipeline().parameters.source_schema, '\".\"', pipeline().parameters.source_table, '\" ORDER BY \"', pipeline().parameters.watermark_column, '\" DESC, \"', pipeline().parameters.tie_breaker_column, '\" DESC LIMIT 1) u ON TRUE')",
              "type": "Expression"
            }
          },
          "firstRowOnly": true,
          "datasetSettings": {
            "annotations": [],
            "type": "PostgreSqlTable",
            "schema": [],
            "typeProperties": {
              "schema": {
                "value": "@pipeline().parameters.source_schema",
                "type": "Expression"
              },
              "table": {
                "value": "@pipeline().parameters.source_table",
                "type": "Expression"
              }
            },
            "version": "2.0",
            "externalReferences": {
              "connection": "e3607aae-ab0a-4954-968c-613ebd192eeb"
            }
          }
        },
        "description": "Captures a fixed source-side upper watermark and observed schema so this run processes a bounded, auditable interval."
      },
      {
        "name": "PrepareControlledBatch",
        "type": "Script",
        "dependsOn": [
          {
            "activity": "CaptureUpperBoundAndSchema",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.00:05:00",
          "retry": 1,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "scripts": [
            {
              "type": "Query",
              "text": {
                "value": "@concat('EXEC control.sp_prepare_bronze_watermark_run @pipeline_run_id = ''', pipeline().RunId, ''', @parent_pipeline_run_id = ''', pipeline().TriggeredByPipelineRunId, ''', @source_object_id = ', pipeline().parameters.source_object_id, ', @upper_watermark = ''', activity('CaptureUpperBoundAndSchema').output.firstRow.upper_watermark, ''', @upper_tie_breaker = ''', activity('CaptureUpperBoundAndSchema').output.firstRow.upper_tie_breaker, ''', @observed_columns_csv = ''', activity('CaptureUpperBoundAndSchema').output.firstRow.columns_csv, ''', @observed_schema_json = ''', replace(activity('CaptureUpperBoundAndSchema').output.firstRow.schema_json, '''', ''''''), ''';')",
                "type": "Expression"
              }
            }
          ],
          "scriptBlockExecutionTimeout": "00:02:00"
        },
        "externalReferences": {
          "connection": "ffb74af9-9d17-4429-8493-02465e631244"
        },
        "description": "Acquires the object lease and registers the deterministic batch and expected interval in the control warehouse before copying."
      },
      {
        "name": "ProcessPreparedBatch",
        "type": "IfCondition",
