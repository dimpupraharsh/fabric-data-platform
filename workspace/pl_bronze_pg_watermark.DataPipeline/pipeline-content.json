          "ifTrueActivities": [
            {
              "name": "CountBoundedSourceRows",
              "type": "Lookup",
              "dependsOn": [],
              "policy": {
                "timeout": "0.02:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "source": {
                  "type": "PostgreSqlSource",
                  "partitionOption": "None",
                  "queryTimeout": "02:00:00",
                  "query": {
                    "value": "@concat('SELECT COUNT(*)::bigint AS rows_expected FROM \"', pipeline().parameters.source_schema, '\".\"', pipeline().parameters.source_table, '\" WHERE (\"', pipeline().parameters.watermark_column, '\" > TIMESTAMPTZ ''', activity('PrepareControlledBatch').output.resultSets[0].rows[0].lower_watermark, '+00:00'' OR (\"', pipeline().parameters.watermark_column, '\" = TIMESTAMPTZ ''', activity('PrepareControlledBatch').output.resultSets[0].rows[0].lower_watermark, '+00:00'' AND \"', pipeline().parameters.tie_breaker_column, '\" > ', activity('PrepareControlledBatch').output.resultSets[0].rows[0].lower_tie_breaker, ')) AND (\"', pipeline().parameters.watermark_column, '\" < TIMESTAMPTZ ''', activity('PrepareControlledBatch').output.resultSets[0].rows[0].upper_watermark, '+00:00'' OR (\"', pipeline().parameters.watermark_column, '\" = TIMESTAMPTZ ''', activity('PrepareControlledBatch').output.resultSets[0].rows[0].upper_watermark, '+00:00'' AND \"', pipeline().parameters.tie_breaker_column, '\" <= ', activity('PrepareControlledBatch').output.resultSets[0].rows[0].upper_tie_breaker, '))')",
                    "type": "Expression"
                  }
                },
                "firstRowOnly": true,
                "datasetSettings": {
                  "annotations": [],
                  "type": "PostgreSqlTable",
                  "schema": [],
                  "typeProperties": {
                    "schema": {
                      "value": "@pipeline().parameters.source_schema",
                      "type": "Expression"
                    },
                    "table": {
                      "value": "@pipeline().parameters.source_table",
                      "type": "Expression"
                    }
                  },
                  "version": "2.0",
                  "externalReferences": {
                    "connection": "e3607aae-ab0a-4954-968c-613ebd192eeb"
                  }
                }
              },
              "description": "Counts source rows inside the frozen lower/upper timestamp and tie-breaker bounds to establish the expected copy count."
            },
