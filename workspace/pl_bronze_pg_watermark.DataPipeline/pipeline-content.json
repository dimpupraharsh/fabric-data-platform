                  "query": {
                    "value": "@concat('SELECT * FROM \"', pipeline().parameters.source_schema, '\".\"', pipeline().parameters.source_table, '\" WHERE (\"', pipeline().parameters.watermark_column, '\" > TIMESTAMPTZ ''', activity('PrepareControlledBatch').output.resultSets[0].rows[0].lower_watermark, '+00:00'' OR (\"', pipeline().parameters.watermark_column, '\" = TIMESTAMPTZ ''', activity('PrepareControlledBatch').output.resultSets[0].rows[0].lower_watermark, '+00:00'' AND \"', pipeline().parameters.tie_breaker_column, '\" > ', activity('PrepareControlledBatch').output.resultSets[0].rows[0].lower_tie_breaker, ')) AND (\"', pipeline().parameters.watermark_column, '\" < TIMESTAMPTZ ''', activity('PrepareControlledBatch').output.resultSets[0].rows[0].upper_watermark, '+00:00'' OR (\"', pipeline().parameters.watermark_column, '\" = TIMESTAMPTZ ''', activity('PrepareControlledBatch').output.resultSets[0].rows[0].upper_watermark, '+00:00'' AND \"', pipeline().parameters.tie_breaker_column, '\" <= ', activity('PrepareControlledBatch').output.resultSets[0].rows[0].upper_tie_breaker, ')) ORDER BY \"', pipeline().parameters.watermark_column, '\", \"', pipeline().parameters.tie_breaker_column, '\"')",
